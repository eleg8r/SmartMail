{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=SmartMailDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },

  "ApiConfiguration": {
    "EnableGrpc": true,
    "EnableRestApi": true,
    "DefaultApiType": "Grpc"
  },

  "Authentication": {
    "Mode": "ApiKey",
    "Jwt": {
      "Secret": "YourSuperSecretKeyHere_ChangeInProduction_MustBe256BitsOrMore",
      "Issuer": "SmartMail",
      "Audience": "SmartMail.API",
      "ExpirationMinutes": 60
    },
    "ApiKey": {
      "HeaderName": "X-API-Key",
      "ValidateExpiration": true
    }
  },

  "EmailService": {
    "DefaultProvider": "Smtp",
    "MaxRetries": 3,
    "RetryDelayMs": 1000
  },

  "EmailProviders": {
    "Smtp": {
      "Enabled": true,
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "your-email@gmail.com",
      "Password": "your-app-password",
      "UseSsl": false,
      "UseStartTls": true,
      "DefaultFromAddress": "noreply@smartmail.com",
      "DefaultFromName": "SmartMail"
    },
    "SendGrid": {
      "Enabled": false,
      "ApiKey": "YOUR_SENDGRID_API_KEY",
      "DefaultFromAddress": "noreply@smartmail.com",
      "DefaultFromName": "SmartMail"
    },
    "AwsSes": {
      "Enabled": false,
      "AccessKey": "YOUR_AWS_ACCESS_KEY",
      "SecretKey": "YOUR_AWS_SECRET_KEY",
      "Region": "us-east-1",
      "DefaultFromAddress": "noreply@smartmail.com",
      "DefaultFromName": "SmartMail"
    },
    "Mailgun": {
      "Enabled": false,
      "ApiKey": "YOUR_MAILGUN_API_KEY",
      "Domain": "your-domain.mailgun.org",
      "DefaultFromAddress": "noreply@smartmail.com",
      "DefaultFromName": "SmartMail"
    }
  },

  "Scheduler": {
    "Type": "Custom",
    "Hangfire": {
      "Enabled": false,
      "DashboardEnabled": true,
      "DashboardPath": "/hangfire",
      "WorkerCount": 5
    },
    "Quartz": {
      "Enabled": false,
      "ThreadCount": 10,
      "SchedulerName": "SmartMailScheduler"
    },
    "RabbitMq": {
      "Enabled": false,
      "HostName": "localhost",
      "Port": 5672,
      "Username": "guest",
      "Password": "guest",
      "VirtualHost": "/",
      "QueueName": "smartmail-jobs"
    },
    "Custom": {
      "Enabled": true,
      "CheckIntervalSeconds": 10,
      "MaxConcurrentJobs": 10
    }
  },

  "Tracking": {
    "BaseUrl": "https://track.smartmail.com",
    "PixelEndpoint": "/track/open",
    "ClickEndpoint": "/track/click",
    "EnableOpenTracking": true,
    "EnableClickTracking": true
  },

  "Compliance": {
    "RequireUnsubscribeLink": true,
    "UnsubscribeBaseUrl": "https://smartmail.com/unsubscribe",
    "CompanyName": "Your Company Name",
    "CompanyAddress": "123 Main Street, City, State, ZIP, Country",
    "EnableCanSpamCompliance": true,
    "EnableCaslCompliance": true,
    "IncludePhysicalAddress": true
  },

  "RateLimiting": {
    "DefaultMaxEmailsPerHour": 1000,
    "DefaultMaxEmailsPerDay": 10000,
    "EnableTenantLimits": true,
    "EnableCampaignLimits": true
  },

  "Attachments": {
    "DefaultMaxSizeMb": 25,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "image/gif",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "text/plain",
      "text/csv"
    ],
    "StorageType": "Database"
  },

  "MultiTenancy": {
    "Enabled": true,
    "TenantIdSource": "Header",
    "TenantIdHeaderName": "X-Tenant-ID",
    "RequireTenantValidation": true
  },

  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http1AndHttp2"
    },
    "Endpoints": {
      "Grpc": {
        "Url": "https://localhost:5001",
        "Protocols": "Http2"
      },
      "GrpcWeb": {
        "Url": "https://localhost:5002",
        "Protocols": "Http1AndHttp2"
      },
      "RestApi": {
        "Url": "https://localhost:5003",
        "Protocols": "Http1"
      }
    }
  }
}
